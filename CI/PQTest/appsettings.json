{
  "Logging": {
    "Console": {
      "LogLevel": {
        "Default": "Trace",
        "PQServiceHost": "Trace"
      }
    },
    "RoundRobinFile": {
      "Options": {
        "FilePath": "pqServiceHost_{date}.log"
      },
      "LogLevel": {
        "Default": "Trace",
        "System.Net": "Trace",
        "Microsoft": "Information",
        "PQServiceHost": "Trace"
      }
    },
    "LogLevel": {
      "Default": "Trace",
      "System.Net": "Trace",
      "Microsoft": "Information",
      "PQServiceHost": "Trace"
    }
  },
  "PqServiceHostServer": {
    "Port": "8200",
    "Timeout": "5000"
  },
  "PowerQueryUI": {
    "useLocalResources": true,
    "remoteEndpoint": "https://onebox.pq-df.microsoft.com:8009/",
    "disableWebViewPool": false,
    "forceRightToLeft": false,
    "flowsInitializationDelayInMs": 0,
    "useDevMode": true,
    "useModelessFlows": false,
    "enableGetDataWizardSendFeedbackButton": true,
    "useCultureInfoOverride": false,
    "disableStartFlowTransparent": false,
    "cultureName": "en-US"
  }
}