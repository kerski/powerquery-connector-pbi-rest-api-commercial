// Gated regression test for real-world LZ4_FRAME-compressed Arrow responses.
// The bytes below are a captured Power BI executeDaxQueries Arrow stream
// (EVALUATE DateDim) whose RecordBatch and DictionaryBatch bodies are
// LZ4_FRAME compressed per buffer. This exercises the pure-M LZ4 decoder and
// date64 (MILLISECOND) decoding end to end. Values verified against pyarrow.
// Source capture: tests/fixtures/arrow-fixture-datedim.arrow (.hex).
section ArrowCompressedDatedimTests;

Fact = (_subject as text, _expected, _actual) as record =>
    let
        expected = if Value.Is(_expected, Function.Type) then try _expected() else try _expected,
        actual = if Value.Is(_actual, Function.Type) then try _actual() else try _actual,
        isSuccess =
            if expected[HasError] or actual[HasError] then false
            else expected[Value] = actual[Value],
        details =
            if expected[HasError] then "Expected error"
            else if actual[HasError] then "Actual error: " & (try Text.From(actual[Error][Message]) otherwise "<unknown>")
            else ""
    in
        [Result = if isSuccess then "Success" else "Failure", Notes = _subject, Details = details];

shared MyExtension.UnitTest =
let
    ArrowFromBinary = PBIRESTAPIComm.ArrowFromBinary,

    CellsEqual = (a, b) as logical =>
        if a = null and b = null then true
        else if a = null or b = null then false
        else a = b,

    RowsEqual = (actualRow as list, expectedRow as list) as logical =>
        let
            countOk = List.Count(actualRow) = List.Count(expectedRow),
            pairs = if countOk then List.Zip({actualRow, expectedRow}) else {},
            allOk = List.MatchesAll(pairs, each CellsEqual(_{0}, _{1}))
        in
            countOk and allOk,

    TableCellsMatch = (actual as table, expectedColumns as list, expectedRows as list) as logical =>
        let
            actualColumns = Table.ColumnNames(actual),
            columnsOk = actualColumns = expectedColumns,
            actualRows = if columnsOk then Table.ToRows(actual) else {},
            rowsOk = List.Count(actualRows) = List.Count(expectedRows),
            pairs = if columnsOk and rowsOk then List.Zip({actualRows, expectedRows}) else {},
            allOk = List.MatchesAll(pairs, each RowsEqual(_{0}, _{1}))
        in
            columnsOk and rowsOk and allOk,

    DatedimHex = "",
    DatedimBinary = Binary.FromText(DatedimHex, BinaryEncoding.Hex),
    DatedimTable = ArrowFromBinary(DatedimBinary),
    DatedimExpectedColumns = {"DateDim[DateID]", "DateDim[Date]", "DateDim[DateKey]", "DateDim[MonthYearSort]", "DateDim[Month Year]"},
    DatedimExpectedRows = {
        {973, #date(2020,10,1), "Oct-2020", 202010, "Oct-20"},
        {975, #date(2020,12,1), "Dec-2020", 202012, "Dec-20"},
        {974, #date(2020,11,1), "Nov-2020", 202011, "Nov-20"},
        {979, #date(2021,4,1), "Apr-2021", 202104, "Apr-21"},
        {976, #date(2021,1,1), "Jan-2021", 202101, "Jan-21"},
        {977, #date(2021,2,1), "Feb-2021", 202102, "Feb-21"},
        {978, #date(2021,3,1), "Mar-2021", 202103, "Mar-21"},
        {981, #date(2021,6,1), "Jun-2021", 202106, "Jun-21"},
        {982, #date(2021,7,1), "Jul-2021", 202107, "Jul-21"},
        {980, #date(2021,5,1), "May-2021", 202105, "May-21"}
    },

    facts = {
        Fact("Arrow Compressed Datedim Columns Match",
            true,
            () => Table.ColumnNames(DatedimTable) = DatedimExpectedColumns),
        Fact("Arrow Compressed Datedim Row Count Matches",
            List.Count(DatedimExpectedRows),
            () => Table.RowCount(DatedimTable)),
        Fact("Arrow Compressed Datedim Cells Match (incl. date64 + LZ4)",
            true,
            () => TableCellsMatch(DatedimTable, DatedimExpectedColumns, DatedimExpectedRows))
    },

    failures = List.Select(facts, each _[Result] <> "Success"),
    failureSummary = Text.Combine(List.Transform(failures, each _[Notes] & " :: " & _[Details]), "; "),
    gated =
        if List.Count(failures) > 0
        then error Error.Record("ArrowCompressedDatedimFailure", "One or more compressed datedim facts failed", [Failures = failureSummary])
        else facts
in
    gated;
