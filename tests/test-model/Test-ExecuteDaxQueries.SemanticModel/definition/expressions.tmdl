expression Query1 =
		(binaryInput as binary) as table =>
		let
		    // Convert binary to UTF8
		    RawText =
		        Text.FromBinary(
		            binaryInput,
		            TextEncoding.Utf8
		        ),
		
		    // Remove null characters
		    RemoveNulls =
		        Text.Replace(
		            RawText,
		            Character.FromNumber(0),
		            " "
		        ),
		
		    // Keep readable chars
		    CleanText =
		        Text.Select(
		            RemoveNulls,
		            {
		                "A".."Z",
		                "a".."z",
		                "0".."9",
		                "[", "]",
		                "-", "_",
		                "/",
		                ".",
		                " "
		            }
		        ),
		
		    // Split on spaces
		    Tokens =
		        List.Select(
		            Text.Split(CleanText, " "),
		            each Text.Length(_) > 2
		        ),
		
		    // Remove duplicate tokens
		    DistinctTokens =
		        List.Distinct(Tokens),
		
		    // Convert to table
		    Output =
		        Table.FromColumns(
		            {DistinctTokens},
		            {"ExtractedText"}
		        )
		in
		    Output
	lineageTag: 388cc93a-9d5e-4ceb-af1b-230c43ad92ef

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

